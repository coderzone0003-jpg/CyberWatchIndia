{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "installCommand": "npm install",
  "build": {
    "env": {
      "CI": "false"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cyberwatchindia-backend.onrender.com/api/:path*"
    },
    {
      "source": "/ping",
      "destination": "https://cyberwatchindia-backend.onrender.com/ping"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
