# ============================================
# BACKEND ENVIRONMENT VARIABLES (Render)
# ============================================
# Copy to .env for local dev. Set in Render → Web Service → Environment.

# Server
NODE_ENV=development
PORT=5000

# Frontend URL for CORS + email links (no trailing slash)
# Vercel: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Optional extra CORS origins (comma-separated), e.g. Vercel preview URLs
# ALLOWED_ORIGINS=https://your-app-git-main.vercel.app

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=generate-a-strong-32-char-or-longer-secret

# Admin account (run: npm run create-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPasswordImmediately123!
ADMIN_NAME=System Administrator

# Email (optional — Resend)
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Cyber Crime Portal

# Database setup scripts only (not required at runtime)
# SUPABASE_DB_PASSWORD=your-database-password
