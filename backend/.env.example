# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Supabase Configuration
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database password (Supabase Dashboard → Project Settings → Database)
# Used by: npm run setup-evidence-table
SUPABASE_DB_PASSWORD=your-database-password
# Or full connection string:
# DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# JWT Configuration
# IMPORTANT: Generate a strong random secret for production!
# Use this command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Example strong secret (DO NOT use this in production - generate your own):
JWT_SECRET=abd02a0db59384041310d2a10e72dd200793b10a59b76ed1dcbf50076699f843

# Admin User Creation (for create-admin script)
# IMPORTANT: Change these default values before running the script!
ADMIN_EMAIL=admin@cyberportal.gov
ADMIN_PASSWORD=ChangeThisPasswordImmediately123!
ADMIN_NAME=System Administrator

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Email Configuration (Resend)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key-here
FROM_EMAIL=noreply@cyberportal.gov
FROM_NAME=Cyber Crime Portal

# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# When deploying to production, update these values:

# NODE_ENV=production
# PORT=5000
# FRONTEND_URL=https://your-frontend-domain.com
# JWT_SECRET=GENERATE_NEW_STRONG_SECRET_FOR_PRODUCTION
# ADMIN_PASSWORD=USE_VERY_STRONG_PASSWORD_IN_PRODUCTION
